# Prefix for every API call. Keep it relative so the dev proxy (and, in production,
# a reverse proxy on the same site) forwards it. See docs/PHASE_1 §2.3 and §3.9.
VITE_API_BASE_URL=/api/v1
# Product name shown in the UI.
VITE_APP_NAME=AgentVault
# Where the dev server forwards /api and /health. Not exposed to the browser.
BACKEND_URL=http://localhost:3000
