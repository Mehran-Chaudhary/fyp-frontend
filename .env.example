# Local HTTP testing: open the frontend at http://localhost:5173.
# Public browser configuration only. Never put backend secrets here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Product name shown in the UI.
VITE_APP_NAME=AgentVault
# Optional: show query devtools in development.
# VITE_QUERY_DEVTOOLS=true
# Optional proxy target, only used when VITE_API_BASE_URL is relative.
# BACKEND_URL=http://localhost:3000
# For deployment, override VITE_API_BASE_URL in .env.production or the build
# environment (use /api/v1 when production has a same-origin reverse proxy).
